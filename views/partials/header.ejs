<!DOCTYPE html>
<html lang="mn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Зар.mn | Зарын нэгдсэн сан</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/tailwind.css">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<header class="site-header">
  <a class="logo" href="/"><span class="icon icon--house" aria-hidden="true"></span>Зар.mn</a>
  <nav class="site-nav" aria-label="Үндсэн цэс">
    <a class="nav-link nav-home <%= currentPath === '/' ? 'is-active' : '' %>" href="/" <% if (currentPath === '/') { %>aria-current="page"<% } %>><span class="icon icon--house" aria-hidden="true"></span>Нүүр</a>
    <% if (user) { %>
      <a class="nav-link <%= currentPath === '/my-ads' ? 'is-active' : '' %>" href="/my-ads" <% if (currentPath === '/my-ads') { %>aria-current="page"<% } %>><span class="icon icon--layout-list" aria-hidden="true"></span>Миний зар</a>
      <a class="nav-link nav-action" href="/post"><span class="icon icon--circle-plus" aria-hidden="true"></span>Зар оруулах</a>
      <a class="nav-link nav-logout" href="/logout"><span class="icon icon--log-out" aria-hidden="true"></span>Гарах (<%= user.name %>)</a>
    <% } else { %>
      <a class="nav-link <%= currentPath === '/login' ? 'is-active' : '' %>" href="/login" <% if (currentPath === '/login') { %>aria-current="page"<% } %>><span class="icon icon--log-in" aria-hidden="true"></span>Нэвтрэх</a>
      <a class="nav-link nav-action" href="/register"><span class="icon icon--user-round-plus" aria-hidden="true"></span>Бүртгүүлэх</a>
    <% } %>
  </nav>
</header>
<main>